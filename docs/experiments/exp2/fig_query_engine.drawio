        <mxCell id="e_tool" value="tool&lt;br&gt;calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.25;strokeColor=#000000;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="sandbox">
          <mxGeometry relative="1" as="geometry" />
