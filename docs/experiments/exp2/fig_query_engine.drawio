        <mxCell id="e_stop" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.25;strokeColor=#000000;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="attempt" target="tests">
