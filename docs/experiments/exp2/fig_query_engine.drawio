          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_no" value="no: add attempt k,&lt;br&gt;retry (≤ 3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.25;strokeColor=#000000;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="passed" target="store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="store" value="&lt;b&gt;Relational DB&lt;/b&gt;&lt;br&gt;of all failed attempts&lt;br&gt;&lt;br&gt;attempts · steps&lt;br&gt;file changes&lt;br&gt;derived views&lt;br&gt;&lt;i&gt;(repeated steps, reverted edits)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;strokeWidth=1;fontSize=16;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="240" height="160" as="geometry" />
