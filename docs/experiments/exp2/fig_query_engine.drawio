<mxfile host="app.diagrams.net">
  <diagram id="Query engine over execution history" name="Query engine over execution history">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="task" value="Terminal-Bench&lt;br&gt;task" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=16;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="0" y="110" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="attempt" value="Attempt k" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#404040;strokeWidth=1;verticalAlign=top;fontColor=#000000;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=16;fontFamily=Times New Roman;container=1;collapsible=0;recursiveResize=0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="340" height="250" as="geometry" />
