        </mxCell>
        <mxCell id="prompt" value="&lt;b&gt;Retry prompt&lt;/b&gt; (identical across arms but one sentence)&lt;br&gt;“k previous attempt(s) FAILED the task's tests…”&lt;br&gt;+ arm's evidence sentence + diagnose-then-fix steps + task&lt;br&gt;&lt;i&gt;leak check: no test names, no verifier text&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="loop">
