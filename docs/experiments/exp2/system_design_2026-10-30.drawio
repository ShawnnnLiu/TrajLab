          <mxGeometry x="320" y="360" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="join" value="&lt;b&gt;postprocess&lt;/b&gt;: join on &lt;b&gt;tool_call_id&lt;/b&gt;&lt;br&gt;→ trajectory.enriched.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="cap">
          <mxGeometry x="120" y="465" width="330" height="55" as="geometry" />
        </mxCell>
        <mxCell id="store" value="② Analysis: TrajLab store (one DuckDB file per chain)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="870" y="80" width="420" height="560" as="geometry" />
        </mxCell>
        <mxCell id="reconcile" value="&lt;b&gt;reconcile&lt;/b&gt;: diff checkpoint top layers&lt;br&gt;→ per-step file deltas, with write times" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="store">
          <mxGeometry x="20" y="40" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tables" value="&lt;b&gt;Tables&lt;/b&gt;&lt;br&gt;trials · steps · deltas&lt;br&gt;writes · job_notices · chains&lt;br&gt;&lt;br&gt;&lt;i&gt;attempt 0 = the corpus first attempt;&lt;br&gt;retries 1..t-1 appended&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="store">
          <mxGeometry x="20" y="120" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="heldout" value="&lt;b&gt;checks&lt;br&gt;faults&lt;br&gt;blame&lt;/b&gt;&lt;br&gt;&lt;br&gt;verifier replay&lt;br&gt;scoring only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" vertex="1" parent="store">
          <mxGeometry x="280" y="120" width="120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="views" value="&lt;b&gt;Derived views&lt;/b&gt; (deterministic SQL)&lt;br&gt;step_flags (is_loop, is_revert) · delta_flags · path_versions&lt;br&gt;trial_summary · step_jobs · delta_attribution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="store">
