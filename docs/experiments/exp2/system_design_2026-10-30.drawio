        <mxCell id="task" value="&lt;b&gt;Terminal-Bench 4.0 task&lt;/b&gt;&lt;br&gt;instruction · Docker image · hidden tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
