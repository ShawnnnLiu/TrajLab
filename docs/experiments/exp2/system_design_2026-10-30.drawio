        </mxCell>
        <mxCell id="watcher" value="&lt;b&gt;Watcher&lt;/b&gt; (host)&lt;br&gt;docker commit per mutating call, writes .ack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="cap">
