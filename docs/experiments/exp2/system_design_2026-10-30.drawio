        </mxCell>
        <mxCell id="decide" value="reward = 1&lt;br&gt;or t = N?" style="rhombus;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="loop">
