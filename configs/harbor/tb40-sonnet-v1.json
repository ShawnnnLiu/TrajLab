                "terminal-bench/mvcc-lsm-compaction",
                "terminal-bench/sound-change-cascade",
                "terminal-bench/wal-recovery-ordering",
                "terminal-bench/production-planning",
                "terminal-bench/embedding-drift-monitor",
                "terminal-bench/layout-config-recreation2"
            ]
        }
    ],
    "environment": {
        "import_path": "trajlab.capture.preinstall:PreinstalledDockerEnvironment"
    }
