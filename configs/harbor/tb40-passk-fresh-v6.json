{
    "job_name": "tb40-passk-fresh-v6",
    "jobs_dir": "corpus/jobs",
    "n_attempts": 5,
    "n_concurrent_trials": 2,
    "agent_timeout_multiplier": 0.5,
    "agents": [
        {
            "name": "claude-code",
            "model_name": "anthropic/claude-sonnet-5-5",
            "kwargs": {
                "reasoning_effort": "medium",
                "version": "2.1.278",
                "config": "configs/claude-code/settings.hooks.json"
            }
        }
    ],
    "datasets": [
        {
            "name": "terminal-bench/terminal-bench",
            "ref": "4.0.0",
            "task_names": [
                "terminal-bench/freecad-platform-drawing",
                "terminal-bench/photonic-waveguide-routing",
                "terminal-bench/session-window-debug",
                "terminal-bench/glycan-ms2-elucidation",
                "terminal-bench/hof-topology-interpenetration",
                "terminal-bench/data-anonymization",
                "terminal-bench/ontology-kg-querying",
                "terminal-bench/telecom-entity-resolution"
            ]
        }
    ],
    "environment": {
        "import_path": "trajlab.capture.preinstall:PreinstalledDockerEnvironment"
    }
}
