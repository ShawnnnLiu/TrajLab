{
    "job_name": "tb40-sonnet-v1b",
    "jobs_dir": "corpus/jobs",
    "n_concurrent_trials": 2,
    "agent_timeout_multiplier": 0.25,
    "agents": [
        {
            "name": "claude-code",
            "model_name": "anthropic/claude-sonnet-5-5",
            "kwargs": {
                "reasoning_effort": "medium",
                "version": "2.1.278",
                "config": "configs/claude-code/settings.hooks.json"
            }
        }
    ],
    "datasets": [
        {
            "name": "terminal-bench/terminal-bench",
            "ref": "4.0.0",
            "task_names": [
                "terminal-bench/interleaved-vigenere",
                "terminal-bench/risk-scorer-replay",
                "terminal-bench/cargo-flight-dispatch",
                "terminal-bench/session-window-debug"
            ]
        }
    ],
    "environment": {
        "import_path": "trajlab.capture.preinstall:PreinstalledDockerEnvironment"
    }
}
