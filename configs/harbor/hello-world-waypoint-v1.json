{
    "job_name": "hello-world-waypoint-v1",
    "jobs_dir": "corpus/jobs",
    "n_concurrent_trials": 1,
    "agent_timeout_multiplier": 2.0,
    "agents": [
        {
            "name": "claude-code",
            "model_name": "anthropic/claude-sonnet-5-5",
            "kwargs": {
                "version": "2.1.278"
            }
        }
    ],
    "tasks": [
        {
            "name": "hello-world/hello-world",
            "ref": "latest"
        }
    ],
    "environment": {
        "import_path": "trajlab.capture.waypoint:WaypointEnvironment",
        "kwargs": {
            "state_dir": "/srv/trajlab/waypoint"
        }
    }
}
