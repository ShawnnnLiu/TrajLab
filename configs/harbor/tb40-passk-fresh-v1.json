{
    "job_name": "tb40-passk-fresh-v1",
    "jobs_dir": "corpus/jobs",
    "n_attempts": 20,
    "n_concurrent_trials": 2,
    "agent_timeout_multiplier": 0.5,
    "agents": [
        {
            "name": "claude-code",
            "model_name": "anthropic/claude-sonnet-5-5",
            "kwargs": {
                "reasoning_effort": "medium",
                "version": "2.1.278",
                "config": "configs/claude-code/settings.hooks.json"
            }
        }
    ],
    "datasets": [
        {
            "name": "terminal-bench/terminal-bench",
            "ref": "4.0.0",
            "task_names": [
                "terminal-bench/mvcc-lsm-compaction",
                "terminal-bench/vf2-speedup-networkx",
                "terminal-bench/freecad-platform-drawing",
                "terminal-bench/production-planning",
                "terminal-bench/gsea-proteomics",
                "terminal-bench/bun-sourcemap-leak"
            ]
        }
    ],
    "environment": {
        "import_path": "trajlab.capture.preinstall:PreinstalledDockerEnvironment"
    }
}
