# Pick one credential. Harbor passes these into the task container for Claude Code.
# Subscription (Pro/Max): run `claude setup-token` in your terminal, paste the token here,
# and keep CLAUDE_FORCE_OAUTH=1 so an API key in your shell is never used by mistake.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_FORCE_OAUTH=1
# API key, billed per token. Unset CLAUDE_FORCE_OAUTH above if you use this instead.
# ANTHROPIC_API_KEY=
# optional
TRAJLAB_ACK_WAIT=240
