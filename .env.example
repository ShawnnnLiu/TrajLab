# Pick one credential. Harbor passes these into the task container for Claude Code.
# Subscription (Pro/Max): run `claude setup-token` in your terminal, paste the token here,
# and keep CLAUDE_FORCE_OAUTH=1 so an API key in your shell is never used by mistake.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_FORCE_OAUTH=1
# API key, billed per token. Unset CLAUDE_FORCE_OAUTH above if you use this instead.
# ANTHROPIC_API_KEY=
# The hook's ack wait (TRAJLAB_ACK_WAIT, default 240 s) is not read from here: Harbor does not
# forward arbitrary variables into the container. Override it per run with --ae TRAJLAB_ACK_WAIT=<s>.
# Per-request output-token cap Harbor forwards to Claude Code in the container.
# Claude Code defaults to 32000 and clamps values above 128000. ADR-0005 sets 128000
# because a thinking-only turn at 32000 ends the trial with OutputTokenExceededError.
CLAUDE_CODE_MAX_OUTPUT_TOKENS=128000
